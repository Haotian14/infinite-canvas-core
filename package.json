{
  "name": "infinite-canvas-core",
  "version": "0.1.0",
  "description": "Headless infinite-canvas engine: camera, culling, hit-testing and gestures, with pluggable renderers.",
  "keywords": [
    "infinite-canvas",
    "canvas",
    "viewport",
    "pan-zoom",
    "whiteboard",
    "headless",
    "react",
    "undo-redo"
  ],
  "license": "MIT",
  "author": "Haotian14",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Haotian14/infinite-canvas-core.git"
  },
  "homepage": "https://github.com/Haotian14/infinite-canvas-core#readme",
  "bugs": {
    "url": "https://github.com/Haotian14/infinite-canvas-core/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "demo": "vite examples/basic",
    "bench": "node bench/run.mjs && node bench/update-readme.mjs",
    "bench:headed": "node bench/run.mjs --headed",
    "site": "vite",
    "build:site": "vite build && pnpm build:whiteboard",
    "build:whiteboard": "vite build examples/whiteboard --base ${SITE_BASE:-/infinite-canvas-core/}whiteboard/ --outDir ../../dist-site/whiteboard --emptyOutDir",
    "preview:site": "vite preview",
    "select": "vite examples/select",
    "whiteboard": "vite examples/whiteboard"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^30.1.0",
    "playwright": "^1.63.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
