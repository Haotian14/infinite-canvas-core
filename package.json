{
  "name": "infinite-canvas-core",
  "version": "0.0.0",
  "description": "Headless infinite-canvas engine: camera, culling, hit-testing and gestures, with pluggable renderers.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "demo": "vite examples/basic",
    "bench": "node bench/run.mjs && node bench/update-readme.mjs",
    "bench:headed": "node bench/run.mjs --headed"
  },
  "keywords": [
    "infinite-canvas",
    "canvas",
    "viewport",
    "pan-zoom",
    "whiteboard",
    "headless"
  ],
  "devDependencies": {
    "playwright": "^1.63.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
